# Providers: stt=deepgram|openai|groq  llm=anthropic|openai|google|groq  tts=cartesia|elevenlabs|openai|groq
STT_PROVIDER=deepgram
LLM_PROVIDER=anthropic
TTS_PROVIDER=cartesia

DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Language when policies.yaml has no match for the caller (folder name under agent/locales/)
DEFAULT_LANGUAGE=pt-BR

# Overrides the provider's default model and the locale's voice (optional)
LLM_MODEL=
TTS_VOICE=

# WhatsApp Business Calling API
WHATSAPP_VERIFY_TOKEN=troque-por-um-segredo
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# External APIs (local mock by default)
CRM_BASE_URL=http://localhost:8002/crm
